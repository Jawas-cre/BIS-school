# Database: SQLite for local development. Use a postgres:// URL (and set provider = "postgresql" in prisma/schema.prisma) in production.
DATABASE_URL="file:./dev.db"

# 32+ random characters used to sign session cookies (e.g. `openssl rand -base64 32`).
SESSION_SECRET="change-me-to-a-long-random-string-32-chars-min"

# Optional: enables the AI Assistant.
ANTHROPIC_API_KEY=""

# Copies installed from the zip file update themselves from GitHub while the start-here window is open.
# Set to "off" to stop automatic updates.
BIS_UPDATES="on"

# On a site set up with the start-here file (it has an owner), nobody can open a new center at
# /register/center. Set to "on" to allow it.
BIS_CENTER_SIGNUP="off"
