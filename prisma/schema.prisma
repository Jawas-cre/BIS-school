// BIS Learn — multi-center learning platform for any subject.
// SQLite for local development; switch `provider` to "postgresql" for production.
// String columns are used instead of enums/Json so the schema stays portable.
//
// Content rows (subjects, questions, tests, lessons, decks, library, news) with
// centerId = null belong to the platform and are visible to every center;
// rows with a centerId are private to that center.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ────────────────────────────────────────────────────────────────

model Center {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  city       String?
  about      String?
  accent     String   @default("#2563eb") // brand color used across the center's UI
  inviteCode String   @unique // general student code; InviteCode rows hold extra student and teacher codes
  createdAt  DateTime @default(now())

  branches    Branch[]
  inviteCodes InviteCode[]
  users       User[]
  groups      Group[]
  subjects    Subject[]
  questions   Question[]
  tests       Test[]
  units       RoadmapUnit[]
  vocabDecks  VocabDeck[]
  library     LibraryItem[]
  news        NewsPost[]
}

model Branch {
  id       String  @id @default(cuid())
  centerId String
  name     String
  address  String?
  phone    String?

  center Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  users  User[]
  groups Group[]

  @@index([centerId])
}

// ─── Subjects ───────────────────────────────────────────────────────────────

model Subject {
  id          String  @id @default(cuid())
  centerId    String?
  name        String
  description String?
  color       String  @default("#2563eb")
  icon        String  @default("book") // key into the icon set in src/components/subject-icon.tsx
  order       Int     @default(0)

  center    Center?       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  topics    Topic[]
  groups    Group[]
  questions Question[]
  tests     Test[]
  units     RoadmapUnit[]
  decks     VocabDeck[]
  library   LibraryItem[]

  @@index([centerId])
}

model Topic {
  id        String @id @default(cuid())
  subjectId String
  name      String
  order     Int    @default(0)

  subject   Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions Question[]
  units     RoadmapUnit[]

  @@index([subjectId])
}

model Group {
  id        String   @id @default(cuid())
  centerId  String
  branchId  String?
  subjectId String?
  teacherId String?
  name      String
  schedule  String? // e.g. "Mon/Wed/Fri 16:00"
  createdAt DateTime @default(now())

  center      Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch      Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  subject     Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher     User?         @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  members     GroupMember[]
  unlocks     GroupUnlock[]
  inviteCodes InviteCode[]

  @@index([centerId])
}

// Codes a center admin hands out so students or teachers can create their own accounts.
model InviteCode {
  id        String    @id @default(cuid())
  centerId  String
  code      String    @unique
  role      String // STUDENT | TEACHER
  groupId   String? // students who join with this code are added to the group
  label     String? // the admin's note, e.g. "September intake"
  maxUses   Int? // null = unlimited
  uses      Int       @default(0)
  expiresAt DateTime?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  group  Group? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([centerId])
}

// A student can study several subjects, so they can belong to several groups.
model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  loginId      String?   @unique // teachers' ID, e.g. "T1001" — they can log in with it instead of the email
  passwordHash String
  name         String
  phone        String?
  role         String    @default("STUDENT") // SUPER_ADMIN | CENTER_ADMIN | TEACHER | STUDENT
  isOwner      Boolean   @default(false) // the admin who installed this copy: also manages the platform settings
  centerId     String?
  branchId     String?
  onboarded    Boolean   @default(false)
  grade        String? // school grade or level, e.g. "Grade 10"
  goal         String? // the student's own goal, e.g. "Enter medical school"
  examDate     DateTime?
  targetUniId  String?
  xp           Int       @default(0)
  streak       Int       @default(0)
  bestStreak   Int       @default(0)
  lastActiveOn String? // YYYY-MM-DD of last practice, used for streaks
  createdAt    DateTime  @default(now())

  center        Center?           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  branch        Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberships   GroupMember[]
  teaching      Group[]           @relation("GroupTeacher")
  targetUni     University?       @relation(fields: [targetUniId], references: [id], onDelete: SetNull)
  answers       QuestionAttempt[]
  bookmarks     Bookmark[]
  testAttempts  TestAttempt[]
  unitProgress  UnitProgress[]
  vocab         UserWord[]
  conversations AiConversation[]
  activity      ActivityDay[]
  newsPosts     NewsPost[]

  @@index([centerId])
}

// One row per user per day with activity — powers streaks and the heatmap.
model ActivityDay {
  id        String @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD
  questions Int    @default(0)
  correct   Int    @default(0)
  minutes   Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

// ─── Question bank ──────────────────────────────────────────────────────────

model Question {
  id          String   @id @default(cuid())
  centerId    String?
  subjectId   String
  topicId     String
  difficulty  String // EASY | MEDIUM | HARD
  type        String   @default("MCQ") // MCQ | SHORT (typed answer)
  passage     String?
  stem        String
  choices     String   @default("[]") // JSON string[] for MCQ
  answer      String // "A".."D" for MCQ; accepted answers separated by "|" for SHORT
  explanation String
  createdAt   DateTime @default(now())

  center    Center?           @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject   Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic     Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts  QuestionAttempt[]
  bookmarks Bookmark[]
  inTests   TestQuestion[]

  @@index([subjectId, topicId])
  @@index([centerId])
}

model QuestionAttempt {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  response   String
  correct    Boolean
  seconds    Int      @default(0)
  source     String   @default("BANK") // BANK | TEST | ROADMAP
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, questionId])
  @@index([userId, createdAt])
}

model Bookmark {
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([userId, questionId])
}

// ─── Mock tests ─────────────────────────────────────────────────────────────

model Test {
  id          String   @id @default(cuid())
  centerId    String?
  subjectId   String? // null for mixed-subject exams
  title       String
  description String?
  kind        String // EXAM (several sections) | PRACTICE | TOPIC
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  center   Center?       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject  Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  modules  TestModule[]
  attempts TestAttempt[]

  @@index([centerId])
}

// A timed section of a test.
model TestModule {
  id      String @id @default(cuid())
  testId  String
  order   Int
  title   String
  minutes Int

  test      Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  questions TestQuestion[]
}

model TestQuestion {
  moduleId   String
  questionId String
  order      Int

  module   TestModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([moduleId, questionId])
}

model TestAttempt {
  id            String    @id @default(cuid())
  userId        String
  testId        String
  status        String    @default("IN_PROGRESS") // IN_PROGRESS | COMPLETED
  moduleIndex   Int       @default(0)
  moduleStarted DateTime  @default(now())
  answers       String    @default("{}") // JSON { [questionId]: response }
  flagged       String    @default("[]") // JSON questionId[]
  correct       Int?
  total         Int?
  score         Int? // percent correct
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─── Roadmap (structured course per subject, with video lessons) ────────────

model RoadmapUnit {
  id        String   @id @default(cuid())
  centerId  String?
  subjectId String
  topicId   String? // quiz questions are drawn from this topic
  order     Int
  title     String
  summary   String
  videoUrl  String?
  notes     String   @default("") // markdown lesson notes
  createdAt DateTime @default(now())

  center   Center?        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject  Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic    Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  progress UnitProgress[]
  unlocks  GroupUnlock[]

  @@index([centerId, subjectId, order])
}

model UnitProgress {
  userId      String
  unitId      String
  quizScore   Int? // percent
  completedAt DateTime?

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit RoadmapUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([userId, unitId])
}

// Teachers can unlock roadmap units for a whole group ahead of sequential progress.
model GroupUnlock {
  groupId    String
  unitId     String
  unlockedAt DateTime @default(now())

  group Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  unit  RoadmapUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([groupId, unitId])
}

// ─── Vocabulary ─────────────────────────────────────────────────────────────

model VocabDeck {
  id          String  @id @default(cuid())
  centerId    String?
  subjectId   String?
  title       String
  description String?
  level       String  @default("Beginner") // Beginner | Intermediate | Advanced

  center  Center?     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  words   VocabWord[]
}

model VocabWord {
  id         String @id @default(cuid())
  deckId     String
  word       String
  pos        String // part of speech (or "term")
  definition String
  example    String
  synonyms   String @default("")

  deck  VocabDeck  @relation(fields: [deckId], references: [id], onDelete: Cascade)
  users UserWord[]
}

// Leitner-box spaced repetition state per user per word.
model UserWord {
  userId     String
  wordId     String
  box        Int      @default(0) // 0 = new, 5 = mastered
  nextReview DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word VocabWord @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([userId, wordId])
}

// ─── Library ────────────────────────────────────────────────────────────────

model LibraryItem {
  id          String   @id @default(cuid())
  centerId    String?
  subjectId   String?
  title       String
  author      String?
  description String?
  category    String // BOOK | PRACTICE | GUIDE | VIDEO
  url         String
  pages       Int?
  createdAt   DateTime @default(now())

  center  Center?  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

// ─── Top universities ───────────────────────────────────────────────────────

model University {
  id             String @id @default(cuid())
  name           String @unique
  country        String
  city           String
  lat            Float
  lng            Float
  rank           Int
  acceptanceRate Float? // percent, when published
  tuition        Int? // USD per year for international students, when published
  requirements   String // typical admission requirements
  aid            String
  website        String
  about          String

  fans User[]
}

// ─── News / what's new ──────────────────────────────────────────────────────

model NewsPost {
  id        String   @id @default(cuid())
  centerId  String? // null = platform announcement shown to every center
  authorId  String?
  title     String
  body      String
  tag       String   @default("Announcement") // Announcement | Update | Event | Tip
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  center Center? @relation(fields: [centerId], references: [id], onDelete: Cascade)
  author User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([centerId, createdAt])
}

// ─── AI assistant ───────────────────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}
